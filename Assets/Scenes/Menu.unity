  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.95686275, g: 0.93333334, b: 0.89411765, a: 1}
  m_RaycastTarget: 0
